<?xml version="1.0"?>
<ruleset name="LocalePress Coding Standards">
	<description>WordPress Coding Standards for LocalePress.</description>

	<file>localepress.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>src</file>
	<file>tests</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="localepress"/>
			</property>
		</properties>
	</rule>
</ruleset>
